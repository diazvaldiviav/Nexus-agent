agent:
  name: "Nexus"
  language: "en"

models:
  local:
    provider: ollama
    model: qwen3:14b
    endpoint: http://localhost:11434
    context_window: 32768          # Context window size in tokens (default: 8192)
    max_output_tokens: 4096        # Max tokens in LLM response (default: 2048)
  cloud:
    provider: gemini              # gemini | anthropic | openai
    model: gemini-2.5-flash-lite
    context_window: 1048576        # 1M tokens for cloud models
    max_output_tokens: 8192        # Higher output limit for cloud
    # endpoint:                   # Optional custom endpoint for cloud provider

  # Per-provider API keys (preferred over environment variables)
  # Each provider can also have an optional custom endpoint.
  gemini:
    api_key: ${GEMINI_API_KEY}    # Or set GEMINI_API_KEY / GOOGLE_API_KEY env var
    # endpoint:                   # Optional custom endpoint
  anthropic:
    api_key: ${ANTHROPIC_API_KEY} # Or set ANTHROPIC_API_KEY env var
    # endpoint:                   # Optional custom endpoint
  openai:
    api_key: ${OPENAI_API_KEY}    # Or set OPENAI_API_KEY env var
    # endpoint:                   # Optional custom endpoint

  # --- Available Cloud Providers & Models ---
  #
  # provider: gemini
  #   models: gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
  #
  # provider: anthropic
  #   models: claude-sonnet-4-6 (recommended), claude-opus-4-6, claude-haiku-4-5
  #
  # provider: openai
  #   models: gpt-4o-mini (cheapest), gpt-4o, o1-mini

  routing:
    entity_extraction: local
    interaction_summary: local
    entity_resolution: local
    memory_query_response: local
    complex_reasoning: cloud
    code_generation: cloud
    default: local

embeddings:
  provider: ollama          # ollama | openai
  model: nomic-embed-text   # or text-embedding-3-small for openai
  endpoint: http://localhost:11434
  dimensions: 768
  api_key: ${OPENAI_API_KEY}  # Required for openai provider. Or set OPENAI_API_KEY env var

memory:
  database: ~/.nexus/memory.db
  working_memory_max_tokens: 1000
  relevant_memory_max_tokens: 3000
  max_retrieval_nodes: 20
  relevance_decay_lambda: 0.05
  working_threshold_score: 0.7
  working_threshold_mentions: 3
  archive_threshold_score: 0.05
  archive_threshold_days: 90
  summarization_interval: 10          # Summarize conversation every N turns
  recent_interactions_fetch_limit: 5  # Number of recent summaries to include in context
  deduplication_threshold: 0.85       # Cosine similarity threshold for entity deduplication (0.0-1.0)
  archive_path: ~/.nexus/archive/    # Directory for archived entity JSON files
  compression_enabled: true          # Enable archival of stale Archive-level entities
  context_compaction_threshold: 0.70 # Compact conversation when token usage exceeds this ratio (0.0-1.0)
  compaction_keep_recent_messages: 4 # Number of recent messages to preserve during compaction

mcp:
  max_tool_call_iterations: 3      # Maximum LLM ↔ tool call round-trips per message (default: 3)
  tool_call_timeout_seconds: 30    # Timeout per individual tool call in seconds (default: 30)
  servers:
    # Example: stdio transport (most common — runs a local command)
    # - name: filesystem
    #   transport: stdio
    #   command: npx
    #   args:
    #     - "-y"
    #     - "@modelcontextprotocol/server-filesystem"
    #     - "/path/to/allowed/dir"
    #   env:
    #     NODE_ENV: production

    # Example: Git MCP server (access git repositories)
    # - name: git
    #   transport: stdio
    #   command: uvx
    #   args:
    #     - "mcp-server-git"
    #     - "--repository"
    #     - "/path/to/repo"

    # Example: SSE transport (connects to a remote HTTP server)
    # - name: remote-tools
    #   transport: sse
    #   url: http://localhost:3001/sse

ui:
  theme: fluent
  graph_layout: force-directed
  default_view: chat
