<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexus.Desktop.Views.SettingsView"
             x:Name="SettingsRoot">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#313244">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="(unsaved changes)" FontSize="14" Foreground="#f9e2af"
                           IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24,16" Spacing="24" MaxWidth="600">

                <!-- Local Model -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Local Model (Ollama)" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableLocalModels}"
                                  SelectedItem="{Binding LocalModel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LocalEndpoint}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding LocalEndpointError}" Foreground="#f38ba8" FontSize="11"
                                   IsVisible="{Binding LocalEndpointError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Cloud Model -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Cloud Model" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableCloudProviders}"
                                  SelectedItem="{Binding CloudProvider}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CloudModel}" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <!-- API Keys -->
                <StackPanel Spacing="12">
                    <TextBlock Text="API Keys" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gemini:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GeminiApiKey}"
                                 PasswordChar="*" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Anthropic:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnthropicApiKey}"
                                 PasswordChar="*" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OpenAI:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OpenAiApiKey}"
                                 PasswordChar="*" Margin="0,8,0,0" />
                    </Grid>
                    <Border CornerRadius="4" Padding="8,6"
                            IsVisible="{Binding ApiKeyWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#4df9e2af" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ApiKeyWarning}" Foreground="#f9e2af" FontSize="12" />
                    </Border>
                </StackPanel>

                <!-- Memory -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Memory Settings" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Decay Lambda (0.001-1.0):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding DecayLambda}"
                                       Minimum="0.001" Maximum="1.0" Increment="0.001"
                                       FormatString="F3" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DecayLambdaError}" Foreground="#f38ba8" FontSize="11"
                                   IsVisible="{Binding DecayLambdaError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Summarize every N turns:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding SummarizationInterval}"
                                       Minimum="1" Maximum="100" Increment="1"
                                       FormatString="F0" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding SummarizationIntervalError}" Foreground="#f38ba8" FontSize="11"
                                   IsVisible="{Binding SummarizationIntervalError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Recent summaries in context:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Value="{Binding RecentInteractionsFetchLimit}"
                                       Minimum="1" Maximum="50" Increment="1"
                                       FormatString="F0" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{Binding RecentInteractionsFetchLimitError}" Foreground="#f38ba8" FontSize="11"
                                   IsVisible="{Binding RecentInteractionsFetchLimitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />
                    </Grid>
                </StackPanel>

                <!-- MCP Tool Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="MCP Tool Settings" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max tool call iterations (1-20):" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding MaxToolCallIterations}"
                                       Minimum="1" Maximum="20" Increment="1"
                                       FormatString="F0"
                                       AutomationProperties.Name="Max tool call iterations" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding MaxToolCallIterationsError}" Foreground="#f38ba8" FontSize="12"
                                   IsVisible="{Binding MaxToolCallIterationsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tool call timeout (seconds):" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding ToolCallTimeoutSeconds}"
                                       Minimum="1" Maximum="300" Increment="1"
                                       FormatString="F0" Margin="0,8,0,0"
                                       AutomationProperties.Name="Tool call timeout seconds" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding ToolCallTimeoutSecondsError}" Foreground="#f38ba8" FontSize="12"
                                   IsVisible="{Binding ToolCallTimeoutSecondsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max output lines (1-10000):" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Value="{Binding MaxOutputLines}"
                                       Minimum="1" Maximum="10000" Increment="1"
                                       FormatString="N0" Margin="0,8,0,0"
                                       AutomationProperties.Name="Max output lines" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{Binding MaxOutputLinesError}" Foreground="#f38ba8" FontSize="12"
                                   IsVisible="{Binding MaxOutputLinesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Max output bytes (1000-500000):" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="6" Grid.Column="1"
                                       Value="{Binding MaxOutputBytes}"
                                       Minimum="1000" Maximum="500000" Increment="1000"
                                       FormatString="N0" Margin="0,8,0,0"
                                       AutomationProperties.Name="Max output bytes" />
                        <TextBlock Grid.Row="7" Grid.Column="1"
                                   Text="{Binding MaxOutputBytesError}" Foreground="#f38ba8" FontSize="12"
                                   IsVisible="{Binding MaxOutputBytesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,2,0,0" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Schema validation:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <ToggleSwitch Grid.Row="8" Grid.Column="1"
                                      IsChecked="{Binding SchemaValidationEnabled}"
                                      OnContent="Enabled" OffContent="Disabled"
                                      AutomationProperties.Name="Schema validation"
                                      Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>

                <!-- MCP Servers -->
                <StackPanel Spacing="12">
                    <TextBlock Text="MCP Servers" FontWeight="SemiBold" FontSize="14" />

                    <Border BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="8"
                            IsVisible="{Binding HasMcpServers}">
                        <ListBox ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcpServer}" MaxHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Transport}" Foreground="#bac2de" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding CommandOrUrl}" Foreground="#a6adc8" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Button Grid.Column="0" Content="Connect Selected"
                                Command="{Binding ConnectMcpServerCommand}"
                                CommandParameter="{Binding SelectedMcpServer}"
                                IsEnabled="{Binding IsNotMcpBusy}"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Disconnect Selected"
                                Command="{Binding DisconnectMcpServerCommand}"
                                CommandParameter="{Binding SelectedMcpServer}"
                                IsEnabled="{Binding IsNotMcpBusy}" />
                    </Grid>

                    <Border BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Add server" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewMcpServerName}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Transport:" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                          ItemsSource="{Binding AvailableMcpTransports}"
                                          SelectedItem="{Binding NewMcpServerTransport}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Command / URL:" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                         Text="{Binding NewMcpServerCommandOrUrl}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Args (space separated):" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                                         Text="{Binding NewMcpServerArgs}" />
                            </Grid>

                            <Button Content="Add and Connect" Command="{Binding AddMcpServerCommand}"
                                    HorizontalAlignment="Left" Padding="16,8"
                                    IsEnabled="{Binding IsNotMcpBusy}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Save -->
                <StackPanel Spacing="8">
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Left" Padding="16,8" />
                    <!-- Success banner -->
                    <Border CornerRadius="4" Padding="8,6" IsVisible="{Binding HasSuccess}" Background="#4da6e3a1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#a6e3a1" FontSize="12" />
                    </Border>
                    <!-- Error banner -->
                    <Border CornerRadius="4" Padding="8,6" IsVisible="{Binding HasError}" Background="#4df38ba8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#f38ba8" FontSize="12" />
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
