<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexus.Desktop.ViewModels"
        xmlns:views="using:Nexus.Desktop.Views"
        x:Class="Nexus.Desktop.Views.MainWindow"
        Title="Nexus Agent"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <DockPanel>
        <!-- Navigation sidebar -->
        <Border DockPanel.Dock="Left" Background="#1E1E2E" Width="180">
            <StackPanel Margin="8" Spacing="4">
                <TextBlock Text="NEXUS" FontSize="18" FontWeight="Bold"
                           Foreground="White" Margin="8,16,8,24" />

                <Button Command="{Binding NavigateToChatCommand}"
                        Classes="NavButton"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💬" />
                        <TextBlock Text="Chat" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateToMemoryGraphCommand}"
                        Classes="NavButton"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🧠" />
                        <TextBlock Text="Memory Graph" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateToSettingsCommand}"
                        Classes="NavButton"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙️" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateToActionLogCommand}"
                        Classes="NavButton"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📋" />
                        <TextBlock Text="Action Log" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main content area -->
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ChatViewModel">
                    <views:ChatView />
                </DataTemplate>
                <DataTemplate DataType="vm:MemoryGraphViewModel">
                    <views:MemoryGraphView />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsViewModel">
                    <views:SettingsView />
                </DataTemplate>
                <DataTemplate DataType="vm:ActionLogViewModel">
                    <views:ActionLogView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>

    <Window.Styles>
        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313244"/>
        </Style>
    </Window.Styles>
</Window>
