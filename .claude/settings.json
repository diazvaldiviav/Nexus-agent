{
  "project": {
    "name": "Nexus Agent + Hardware Intelligence",
    "type": "Personal AI Agent with Hardware-Aware Model Recommendation",
    "framework": ".NET 10, Avalonia UI 11.x",
    "language": "C# 13",
    "state_management": "CommunityToolkit.Mvvm (MVVM source generators)",
    "backend": "SQLite (Microsoft.Data.Sqlite), Ollama HTTP API",
    "deployment": "Windows Desktop (Avalonia) + CLI (Spectre.Console)",
    "vcs": "Git + GitHub"
  },
  "agents": {
    "planning_team": [
      "requirements-analyst",
      "architect",
      "architecture-validator"
    ],
    "execution_team": [
      "developer",
      "code-reviewer",
      "ux-analyzer"
    ],
    "qa_team": [
      "tester",
      "debugger"
    ]
  },
  "skills": {
    "shared": [
      "project-knowledge",
      "coding-standards",
      "solid-principles",
      "testing-strategies",
      "design-patterns",
      "dotnet-known-issues"
    ],
    "architect_extra": [
      "hardware-engineering"
    ],
    "ui": [
      "avalonia-ux-principles"
    ],
    "orchestrator": "sprint-orchestrator"
  },
  "quality_gates": {
    "test_coverage_minimum": 80,
    "max_retries_per_story": 2,
    "max_concurrent_tasks": 3,
    "task_timeout_minutes": 10,
    "require_dotnet_build_clean": true,
    "require_dotnet_format_pass": true,
    "require_all_tests_pass": true,
    "require_zero_warnings": true
  },
  "commands": {
    "build": "dotnet build",
    "test": "dotnet test --verbosity normal",
    "format": "dotnet format --verify-no-changes",
    "run_cli": "dotnet run --project src/Nexus.CLI -- chat",
    "run_desktop": "dotnet run --project src/Nexus.Desktop"
  }
}
